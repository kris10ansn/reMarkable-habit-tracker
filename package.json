{
    "name": "habit-tracker",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "format": "prettier --write . && pnpm -r run format",
        "lint": "pnpm -r run lint",
        "typecheck": "pnpm -r run typecheck",
        "mobile:start": "pnpm --filter @habit-tracker/mobile run start",
        "mobile:android": "pnpm --filter @habit-tracker/mobile run android",
        "mobile:ios": "pnpm --filter @habit-tracker/mobile run ios",
        "mobile:build:android": "pnpm --filter @habit-tracker/mobile run build:android",
        "mobile:build:android:preview": "pnpm --filter @habit-tracker/mobile run build:android:preview",
        "mobile:build:android:preview:local": "pnpm --filter @habit-tracker/mobile run build:android:preview:local",
        "mobile:db:generate": "pnpm --filter @habit-tracker/mobile run db:generate",
        "mobile:api:generate": "pnpm --filter @habit-tracker/mobile run api:generate",
        "remarkable:build": "pnpm --filter @habit-tracker/remarkable run build",
        "remarkable:test": "pnpm --filter @habit-tracker/remarkable run test",
        "remarkable:clean": "pnpm --filter @habit-tracker/remarkable run clean",
        "remarkable:deploy": "pnpm --filter @habit-tracker/remarkable run deploy",
        "remarkable:remove": "pnpm --filter @habit-tracker/remarkable run remove",
        "remarkable:backup": "pnpm --filter @habit-tracker/remarkable run backup",
        "remarkable:find-hotspot-ip": "pnpm --filter @habit-tracker/remarkable run find-hotspot-ip",
        "backend:build": "pnpm --filter @habit-tracker/backend run build",
        "backend:start": "pnpm --filter @habit-tracker/backend run start",
        "backend:watch": "pnpm --filter @habit-tracker/backend run watch",
        "backend:test": "pnpm --filter @habit-tracker/backend run test",
        "backend:migrate": "pnpm --filter @habit-tracker/backend run migrate",
        "backend:db:up": "pnpm --filter @habit-tracker/backend run db:up",
        "backend:db:down": "pnpm --filter @habit-tracker/backend run db:down",
        "backend:db:clear": "pnpm --filter @habit-tracker/backend run db:clear"
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    }
}
