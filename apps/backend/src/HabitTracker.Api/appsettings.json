{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HabitTracker": "Host=localhost;Port=5432;Database=habittracker;Username=habittracker;Password=habittracker"
  },
  "Network": {
    // Only production's environment file (see apps/backend/DEPLOY.md step 5) sets this to true —
    // there, Kestrel binds 127.0.0.1 and cloudflared is the only process that can reach it. See
    // Program.cs.
    "TrustProxyHeaders": false
  }
}
