<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Export the OpenAPI document to apps/backend/openapi.json on every build, and commit it. That
    file is the contract clients generate from (mobile runs kubb over it), so codegen needs neither
    a running API nor a database — and a contract change shows up as a reviewable diff next to the
    DTO change that caused it. `dotnet build` regenerates it; see the backend README.
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>../..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.11 is the first release to floor Microsoft.OpenApi at 2.7.5, which patches
         GHSA-v5pm-xwqc-g5wc; earlier 10.0.x hard-depend on the vulnerable 2.0.0. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin Relational to match Design/Tests (10.0.9); Npgsql 10.0.2 only floors it at 10.0.4. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>

</Project>
